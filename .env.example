# ---------------------------------------------------------------------------
# NZ Marine Hotspot Predictor — all optional.
# With this file copied to .env and left blank, the pipeline runs end to end
# on synthetic ocean and bathymetry data. See TODO_USER_SETUP.md.
# ---------------------------------------------------------------------------

# Ocean data --------------------------------------------------------------
# Open-Meteo Marine needs no key. Set to false to force synthetic data
# (useful offline, and makes runs reproducible).
USE_LIVE_OCEAN_DATA=true
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OCEAN_FETCH_TIMEOUT_S=20
# Points per axis sampled from the live API (one HTTP call each — 5 => 25 calls).
LIVE_SAMPLE_POINTS=5

# Copernicus Marine Service (optional, stubbed). Register free at
# https://data.marine.copernicus.eu/register
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_DATASET_ID=

# Bathymetry ---------------------------------------------------------------
# Path to a depth/elevation raster (GeoTIFF). Leave blank and drop any
# .tif/.nc into data/bathymetry/ instead — the first one found is used.
LINZ_BATHYMETRY_FILE=

# Frontend ----------------------------------------------------------------
# Optional Mapbox GL token. The UI ships with free Esri Ocean + CARTO dark
# tiles and does not need this.
MAPBOX_TOKEN=

# Engine tuning -----------------------------------------------------------
GRID_RESOLUTION_M=500
WEIGHT_TEMP_GRADIENT=0.4
WEIGHT_DEPTH_SLOPE=0.4
WEIGHT_CURRENT=0.2
# Productivity. Set to 0 to get the brief's original three-term formula back.
WEIGHT_CHLOROPHYLL=0.15
FRONT_THRESHOLD_C_PER_KM=0.5
TEMP_GRADIENT_CEILING_C_PER_KM=0.8
SLOPE_CEILING_DEG=6.0
CURRENT_CEILING_MS=0.7
DEPTH_MIN_FISHABLE_M=12
DEPTH_MAX_FISHABLE_M=250

# Chlorophyll-a (mg/m^3). Productive water is a band, not "more is better".
CHL_IDEAL_MIN_MG_M3=0.25
CHL_IDEAL_MAX_MG_M3=1.20
USE_LIVE_CHLOROPHYLL=true

# Bite window weights (temporal: when to go, not where). These never touch
# the per-cell score -- tide, light and moon shift every cell equally.
WEIGHT_TIDE_MOVEMENT=0.50
WEIGHT_LIGHT=0.35
WEIGHT_MOON=0.15

# Fishability limits for a trailer boat off Tutukaka.
WIND_COMFORTABLE_KT=10
WIND_MAX_KT=25
SWELL_COMFORTABLE_M=1.0
SWELL_MAX_M=2.5
USE_LIVE_WEATHER=true

# Catch log used by scripts/calibrate.py
CATCH_LOG_PATH=data/catch_log.csv

# Bounding box (Tutukaka Coast to Poor Knights Shelf)
BBOX_LAT_MIN=-35.80
BBOX_LAT_MAX=-35.30
BBOX_LON_MIN=174.30
BBOX_LON_MAX=174.90

RANDOM_SEED=20260922

+// ---- No-take marine reserves (DOC Marine Reserves layer) ----------------
+// Fishing is banned inside these. Cells touching one are removed before
+// anything is ranked, drawn or exported, whatever the daily file contains.
+let reserveLayer = null;
+let reserveRings = [];   // [{ring: [[lon,lat],...], bbox:[w,s,e,n]}]
+let reservesOn = true;
+function loadReserveRings(fc) {
+  reserveRings = [];
+  fc.features.forEach((f) => {
+    const g = f.geometry;
+    const polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
+    polys.forEach((poly) => {
+      const ring = poly[0];
+      let w = 180, s = 90, e = -180, n = -90;
+      ring.forEach(([x, y]) => { w = Math.min(w, x); e = Math.max(e, x); s = Math.min(s, y); n = Math.max(n, y); });
+      reserveRings.push({ ring, bbox: [w, s, e, n] });
+    });
+  });
+}
+function pointInRing(x, y, ring) {
+  let inside = false;
+  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
+    const [xi, yi] = ring[i], [xj, yj] = ring[j];
+    if ((yi > y) !== (yj > y) && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
+// Margin of ~110 m so a mark never sits on the line.
+const RES_MARGIN = 0.001;
+function inReserve(x, y) {
+  return reserveRings.some(({ ring, bbox }) =>
+    x >= bbox[0] - RES_MARGIN && x <= bbox[2] + RES_MARGIN && y >= bbox[1] - RES_MARGIN && y <= bbox[3] + RES_MARGIN &&
+    (pointInRing(x, y, ring) || [[RES_MARGIN, 0], [-RES_MARGIN, 0], [0, RES_MARGIN], [0, -RES_MARGIN]].some(([dx, dy]) => pointInRing(x + dx, y + dy, ring))));
+}
+function cellTouchesReserve(f) {
+  const ring = f.geometry.coordinates[0];
+  return inReserve(f.properties.lon, f.properties.lat) || ring.some(([x, y]) => inReserve(x, y));
+}
+function applyReserveLayer() {
+  if (reserveLayer) {
+    if (reservesOn && !map.hasLayer(reserveLayer)) reserveLayer.addTo(map);
+    if (!reservesOn && map.hasLayer(reserveLayer)) map.removeLayer(reserveLayer);
+  }
+  el("reserve-toggle").setAttribute("aria-pressed", String(reservesOn));
+}
+el("reserve-toggle").addEventListener("click", () => { reservesOn = !reservesOn; applyReserveLayer(); });
